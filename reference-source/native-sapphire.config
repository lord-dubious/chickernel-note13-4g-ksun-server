# Redmi Note 13 4G: sapphire (non-NFC), sapphiren (NFC).
# Keep peripheral requests separate from server features. Runtime hardware
# support still depends on matching device trees, vendor modules and userspace.
CONFIG_LOCALVERSION="-chickernel-stable-7-ksun-server"

# Optional generic LIRC devices. These are NOT the stock phone's IR path.
# Stock IR uses the lc,ir-spi DT node, spidev.ko, spi-msm-geni.ko and
# /dev/spidev0.1. Keep the matching vendor modules and existing DT intact;
# do not force a second controller/driver built-in without a device audit.
CONFIG_SPI=y
CONFIG_RC_CORE=y
CONFIG_LIRC=y
CONFIG_RC_DECODERS=y
CONFIG_RC_DEVICES=y
CONFIG_IR_NEC_DECODER=y
CONFIG_IR_RC5_DECODER=y
CONFIG_IR_RC6_DECODER=y
CONFIG_IR_JVC_DECODER=y
CONFIG_IR_SONY_DECODER=y
CONFIG_IR_SANYO_DECODER=y
CONFIG_IR_SHARP_DECODER=y
CONFIG_IR_MCE_KBD_DECODER=y
CONFIG_IR_XMP_DECODER=y
CONFIG_IR_IMON_DECODER=y
CONFIG_IR_RCMM_DECODER=y
CONFIG_IR_GPIO_CIR=y
CONFIG_IR_GPIO_TX=y
CONFIG_IR_PWM_TX=y

# Hardware plumbing used by the generic IR TX drivers and native peripherals
CONFIG_GPIOLIB=y
CONFIG_GPIO_CDEV=y
CONFIG_GPIO_CDEV_V1=y
CONFIG_GPIO_GENERIC=y
CONFIG_GPIO_GENERIC_PLATFORM=y
CONFIG_PWM=y
CONFIG_PWM_SYSFS=y

# Keep device-native Android hardware paths available
CONFIG_INPUT=y
CONFIG_INPUT_EVDEV=y
CONFIG_INPUT_TOUCHSCREEN=y
CONFIG_INPUT_FINGERPRINT=y
CONFIG_INPUT_MISC=y
CONFIG_INPUT_UINPUT=y

# No built-in NFC controller is present on sapphire, but keep the generic
# stack and common USB reader drivers available for external USB-C tools.
CONFIG_NFC=y
CONFIG_NFC_DIGITAL=y
CONFIG_NFC_NCI=y
CONFIG_NFC_PORT100=y
CONFIG_NFC_PN533_USB=y

CONFIG_USB_ROLE_SWITCH=y
CONFIG_USB_DWC3_DUAL_ROLE=y
CONFIG_MMC=y
CONFIG_MMC_BLOCK=y
CONFIG_MMC_CRYPTO=y
CONFIG_MMC_SDHCI=y
CONFIG_MMC_SDHCI_PLTFM=y
CONFIG_LEDS_CLASS=y
CONFIG_LEDS_CLASS_FLASH=y
CONFIG_LEDS_CLASS_MULTICOLOR=y
CONFIG_RTC_CLASS=y
CONFIG_IIO=y
CONFIG_IIO_BUFFER=y
CONFIG_IIO_KFIFO_BUF=y
CONFIG_IIO_TRIGGER=y
CONFIG_IIO_TRIGGERED_BUFFER=y
# Stock Xiaomi ExtM sysfs API and storage-backed zRAM writeback.
# Userspace sizing/activation must be validated separately against the ROM.
CONFIG_ZRAM_WRITEBACK=y
CONFIG_MIUI_ZRAM_MEMORY_TRACKING=y
