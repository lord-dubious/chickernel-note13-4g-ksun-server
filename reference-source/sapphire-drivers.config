# Device modules needed by the stock sapphire vendor and first-stage ramdisk.
# Merge for the mixed module build only; retain generic kernel built-ins (-y).
CONFIG_SPI_SPIDEV=m
CONFIG_LEDS_GPIO=m
CONFIG_QCOM_AOSS_QMP=m
CONFIG_QCOM_MICRODUMP=m
CONFIG_QCOM_SYSMON=m
CONFIG_MI_THERMAL_INTERFACE=m
CONFIG_POWER_RESET_QCOM_DOWNLOAD_MODE=m
CONFIG_QCOM_PMIC_VOTER=m
CONFIG_QPNP_QG=m
CONFIG_QPNP_SMB5=m
# CONFIG_QPNP_SMBLITE is not set
CONFIG_CPU_MAX_FREQ=m
CONFIG_QCOM_SERIAL_NUM=m
CONFIG_SIMTRAY_STATUS=m
CONFIG_ANT_CHECK=m
CONFIG_ANT_CHECK_DIV=m
# CONFIG_ARCH_SCUBA is not set
# CONFIG_LEDS_QPNP_FLASH_V2 is not set
