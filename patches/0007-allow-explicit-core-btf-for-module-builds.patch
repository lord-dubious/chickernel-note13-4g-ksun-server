--- a/scripts/Makefile.modfinal
+++ b/scripts/Makefile.modfinal
@@ -13,6 +13,10 @@
 include $(srctree)/scripts/Makefile.lib
 
 mixed-build-prefix = $(if $(KBUILD_MIXED_TREE),$(KBUILD_MIXED_TREE)/)
+
+# Allow exact BTF metadata extracted from a prebuilt kernel Image.
+# The usual full-kernel ELF remains the default.
+VMLINUX_BTF_BASE ?= $(mixed-build-prefix)vmlinux
 
 # find all modules listed in modules.order
 modules := $(sort $(shell cat $(MODORDER)))
@@ -41,10 +45,10 @@
 
 quiet_cmd_btf_ko = BTF [M] $@
       cmd_btf_ko = 							\
-	if [ -f $(mixed-build-prefix)vmlinux ]; then						\
-		LLVM_OBJCOPY="$(OBJCOPY)" $(PAHOLE) -J $(PAHOLE_FLAGS) --btf_base $(mixed-build-prefix)vmlinux $@; \
+	if [ -f $(VMLINUX_BTF_BASE) ]; then						\
+		LLVM_OBJCOPY="$(OBJCOPY)" $(PAHOLE) -J $(PAHOLE_FLAGS) --btf_base $(VMLINUX_BTF_BASE) $@; \
 	else								\
-		printf "Skipping BTF generation for %s due to unavailability of $(mixed-build-prefix)vmlinux\n" $@ 1>&2; \
+		printf "Skipping BTF generation for %s due to unavailability of $(VMLINUX_BTF_BASE)\n" $@ 1>&2; \
 	fi;
 
 # Same as newer-prereqs, but allows to exclude specified extra dependencies
@@ -57,8 +61,8 @@
 
 
 # Re-generate module BTFs if either module's .ko or vmlinux changed
-$(modules): %.ko: %$(mod-prelink-ext).o %.mod.o scripts/module.lds $(if $(KBUILD_BUILTIN),$(mixed-build-prefix)vmlinux) FORCE
-	+$(call if_changed_except,ld_ko_o,$(mixed-build-prefix)vmlinux)
+$(modules): %.ko: %$(mod-prelink-ext).o %.mod.o scripts/module.lds $(if $(KBUILD_BUILTIN),$(VMLINUX_BTF_BASE)) FORCE
+	+$(call if_changed_except,ld_ko_o,$(VMLINUX_BTF_BASE))
 ifdef CONFIG_DEBUG_INFO_BTF_MODULES
 	+$(if $(newer-prereqs),$(call cmd,btf_ko))
 endif
